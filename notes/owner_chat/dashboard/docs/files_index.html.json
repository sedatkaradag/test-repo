{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .hi { --hi-gap: var(--cds-gap-xl); display: flex; flex-direction: column; gap: var(--hi-gap); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .hi h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .hi h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0 0 var(--cds-gap-xs); text-wrap: balance; }\n  .hi h3 { font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); margin: 0 0 var(--cds-gap-xs); }\n  .hi p { margin: 0; max-width: 72ch; line-height: 1.55; }\n  .hi .muted { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n  .hi .lead { font-size: var(--cds-font-size-body); color: var(--color-fg); max-width: 72ch; }\n  .hi section { display: flex; flex-direction: column; gap: var(--cds-gap-md); min-width: 0; }\n  .hi .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--cds-gap-md); }\n  .hi .tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-xs); min-width: 0; }\n  .hi .tile .big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: 2rem; font-variant-numeric: tabular-nums; line-height: 1.1; }\n  .hi .tile .lbl { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .hi .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--cds-gap-lg); }\n  .hi .card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n  .hi .chart { position: relative; min-height: 160px; width: 100%; }\n  .hi .chart svg { display: block; width: 100%; overflow: visible; }\n  .hi .chart text { fill: var(--cds-text-secondary); font-size: var(--cds-font-size-caption); font-family: var(--font-anthropic-sans); }\n  .hi .chart .val { fill: var(--color-fg); font-variant-numeric: tabular-nums; }\n  .hi .tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); color: var(--color-fg); white-space: nowrap; z-index: 2; }\n  .hi .tablewrap { overflow-x: auto; }\n  .hi table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .hi th, .hi td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n  .hi th { color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); white-space: nowrap; }\n  .hi td.num, .hi th.num { text-align: right; white-space: nowrap; }\n  .hi .good { color: var(--color-ok); }\n  .hi .bad { color: var(--color-bad); }\n  .hi .plan td:first-child { white-space: nowrap; font-weight: var(--cds-font-weight-medium); }\n  .hi ol, .hi ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: var(--cds-gap-sm); max-width: 78ch; line-height: 1.5; }\n  .hi .pill { display: inline-block; font-size: var(--cds-font-size-caption); border: 1px solid var(--color-border-line); border-radius: 999px; padding: 1px 8px; color: var(--color-fg-muted); margin-right: 4px; }\n  .hi details summary { cursor: pointer; color: var(--color-fg-muted); }\n  .hi [data-dash-source-state=refreshing] { opacity: .5; }\n</style>\n\n<div class=\"hi\" lang=\"tr\" data-read>\n  <header id=\"baslik\" style=\"display:flex;flex-direction:column;gap:var(--cds-gap-sm)\">\n    <h1>Hangi saatte, hangi içerik?</h1>\n    <p class=\"lead\">Takipçi neredeyse tamamen keşfetten geliyor ve takip, erişimle birlikte artıyor; bu yüzden en çok erişen formatlar büyümeyi sürüklüyor. Guess the Surah aynı yaştaki ayet Reels'inin ortalama <b data-draw=\"gtsRatio\" data-source=\"formats\" data-field=\"reach_ratio\" data-where=\"format=Guess the Surah\">—</b> katı erişim aldı. Ayet konularında en iyisi <b data-draw=\"topCat\" data-source=\"categories\" data-field=\"category\" data-row=\"0\">—</b>. Saat farkları ise küçük.</p>\n    <p class=\"muted\">Veri: Instagram API, 21 Ekim – 10 Kasım 2026. Reels'ler 24. saatteki değerleriyle karşılaştırıldı (gece toplamanın anlık görüntülerinden), elle paylaşılanlar aynı yaştaki ayet Reels'leriyle.</p>\n  </header>\n\n  <section id=\"ozet\">\n    <div class=\"tiles\">\n      <div class=\"tile\"><span class=\"lbl\">Takipçi (10 Kasım)</span><span class=\"big\" data-draw=\"followers\" data-source=\"account\" data-field=\"followers\" data-row=\"0\">—</span><span class=\"lbl\">26 Ekim: 58</span></div>\n      <div class=\"tile\"><span class=\"lbl\">Yeni takip, son 7 gün (2–8 Kasım)</span><span class=\"big\" data-draw=\"follows7\" data-source=\"growth\" data-field=\"follows_7d\" data-row=\"0\">—</span><span class=\"lbl\">Takipten çıkma: <span data-draw=\"unf7\" data-source=\"growth\" data-field=\"unfollows_7d\" data-row=\"0\">—</span></span></div>\n      <div class=\"tile\"><span class=\"lbl\">Erişimin takipçi olmayanlardan gelen payı</span><span class=\"big\" data-draw=\"nfShare\" data-source=\"growth\" data-field=\"non_follower_pct\" data-row=\"0\">—</span><span class=\"lbl\">27 Ekim – 8 Kasım</span></div>\n      <div class=\"tile\"><span class=\"lbl\">1.000 takipçi-dışı erişim başına takip</span><span class=\"big\" data-draw=\"per1k\" data-source=\"growth\" data-field=\"follows_per_1000\" data-row=\"0\">—</span><span class=\"lbl\">Büyüme = erişim × bu oran</span></div>\n    </div>\n  </section>\n\n  <section id=\"buyume\">\n    <h2>Büyüme günlük takiple birlikte hareket ediyor</h2>\n    <p>En çok takip gelen günler, en çok erişilen günler: 4 Kasım'da ikinci quiz, 3 Kasım'da Nâs Reels'i ve ilk quiz. Her gün tek başına ölçüldü (Instagram günü, Pasifik saati).</p>\n    <div class=\"card\">\n      <h3>Günlük yeni takip</h3>\n      <div class=\"chart\" id=\"chartFollows\" data-draw=\"follows\" data-source=\"daily\"></div>\n      <h3>Günlük takipçi olmayanlara erişim</h3>\n      <div class=\"chart\" id=\"chartReach\" data-draw=\"reachDaily\" data-source=\"daily\"></div>\n    </div>\n  </section>\n\n  <section id=\"formatlar\">\n    <h2>Formatlar: elle yapılanlar, aynı yaştaki ayet Reels'ine göre</h2>\n    <p>Oran 1'in üstündeyse format aynı günlerde paylaşılan ayet Reels'inden fazla erişmiş demek. İzlenme saniye, atlanma ilk 3 saniyede geçenlerin yüzdesi.</p>\n    <div class=\"tablewrap\">\n      <table id=\"tblFormats\" data-source=\"formats\" data-row-key=\"format\">\n        <thead><tr><th data-field=\"format\">Format</th><th class=\"num\" data-field=\"n\">Deneme</th><th class=\"num\" data-field=\"reach_ratio\">Erişim oranı</th><th class=\"num\" data-field=\"watch_s\">İzlenme</th><th class=\"num\" data-field=\"verse_watch_s\">Ayet izlenme</th><th class=\"num\" data-field=\"skip_pct\">Atlanma %</th><th class=\"num\" data-field=\"verse_skip_pct\">Ayet atlanma %</th><th class=\"num\" data-field=\"save_pct\">Kayıt %</th><th class=\"num\" data-field=\"verse_save_pct\">Ayet kayıt %</th><th class=\"num\" data-field=\"share_pct\">Paylaşım %</th><th class=\"num\" data-field=\"verse_share_pct\">Ayet paylaşım %</th><th class=\"num\" data-field=\"comments\">Yorum ort.</th></tr></thead>\n        <tbody data-draw=\"formatsBody\"></tbody>\n      </table>\n    </div>\n    <p class=\"muted\">Tesbih tek deneme ve 19 saatlikken ölçüldü; hüküm için 48. saati bekleyin.</p>\n  </section>\n\n  <section id=\"konular\">\n    <h2>Ayet Reels'inde konu: kısa sureler ve insanlara dair pratik ayetler önde</h2>\n    <p>24. saatteki medyan erişim. Kayıt ve paylaşım, erişime oranla yüzde.</p>\n    <div class=\"grid2\">\n      <div class=\"card\"><h3>Medyan erişim (24. saat)</h3><div class=\"chart\" id=\"chartCats\" data-draw=\"cats\" data-source=\"categories\"></div></div>\n      <div class=\"card\">\n        <h3>Kayıt ve paylaşım oranı</h3>\n        <div class=\"tablewrap\">\n          <table id=\"tblCats\" data-source=\"categories\" data-row-key=\"category\">\n            <thead><tr><th data-field=\"category\">Konu</th><th class=\"num\" data-field=\"n\">n</th><th class=\"num\" data-field=\"save_pct\">Kayıt %</th><th class=\"num\" data-field=\"share_pct\">Paylaşım %</th><th class=\"num\" data-field=\"watch_s\">İzlenme</th></tr></thead>\n            <tbody data-draw=\"catsBody\"></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"saatler\">\n    <h2>Saatler: ayet slotları arasındaki fark küçük</h2>\n    <p>27 Ekim'den beri her slot. Erişimin çoğu takipçi dışından geldiği için takipçilerin çevrimiçi olduğu saat belirleyici değil; ama kitlenin büyük kısmı Hindistan ve Pakistan'da.</p>\n    <div class=\"tablewrap\">\n      <table id=\"tblSlots\" data-source=\"slots\" data-row-key=\"group\">\n        <thead><tr><th data-field=\"slot_label\">Slot</th><th data-field=\"content\">Tür</th><th class=\"num\" data-field=\"n\">n</th><th class=\"num\" data-field=\"median_reach\">Medyan erişim</th><th class=\"num\" data-field=\"save_pct\">Kayıt %</th><th class=\"num\" data-field=\"share_pct\">Paylaşım %</th><th class=\"num\" data-field=\"watch_s\">İzlenme</th><th class=\"num\" data-field=\"skip_pct\">Atlanma %</th></tr></thead>\n        <tbody data-draw=\"slotsBody\"></tbody>\n      </table>\n    </div>\n    <div class=\"grid2\">\n      <div class=\"card\"><h3>Takipçilerin çevrimiçi olduğu saat (İstanbul saati)</h3><div class=\"chart\" id=\"chartOnline\" data-draw=\"online\" data-source=\"online\"></div><p class=\"muted\">Çizgiler bizim slotlarımız: 04:30, 10:15, 18:30, 21:00.</p></div>\n      <div class=\"card\"><h3>Ülke (ilk 6)</h3><div class=\"chart\" id=\"chartAud\" data-draw=\"aud\" data-source=\"audience\"></div></div>\n    </div>\n  </section>\n\n  <section id=\"detay\">\n    <h2>Kanca, süre ve kâri</h2>\n    <p>Gruplar küçük; bunları kesin kural değil yön olarak okuyun.</p>\n    <div class=\"grid2\">\n      <div class=\"card\"><h3>Kanca türü (medyan erişim)</h3><div class=\"chart\" id=\"chartHooks\" data-draw=\"hooks\" data-source=\"hooks\"></div></div>\n      <div class=\"card\"><h3>Video süresi (medyan erişim)</h3><div class=\"chart\" id=\"chartDur\" data-draw=\"durs\" data-source=\"durations\"></div></div>\n      <div class=\"card\"><h3>Kâri (en az 5 Reels, medyan erişim)</h3><div class=\"chart\" id=\"chartRec\" data-draw=\"recs\" data-source=\"reciters\"></div></div>\n    </div>\n  </section>\n\n  <section id=\"enler\">\n    <h2>En çok ve en az erişen Reels'ler (24. saat)</h2>\n    <div class=\"tablewrap\">\n      <table id=\"tblTop\" data-source=\"reels\" data-row-key=\"ref\">\n        <thead><tr><th data-field=\"ref\">Kaynak</th><th data-field=\"hook\">Kanca</th><th data-field=\"category\">Konu</th><th data-field=\"slot\">Slot</th><th class=\"num\" data-field=\"reach\">Erişim</th><th class=\"num\" data-field=\"saved\">Kayıt</th><th class=\"num\" data-field=\"shares\">Paylaşım</th></tr></thead>\n        <tbody data-draw=\"topBody\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"plan\">\n    <h2>Öneri: haftalık plan</h2>\n    <p>Saat değil içerik ve format büyük fark yaratıyor. Sistemin 4 ayet slotu kalıyor, her slota bir rol veriyoruz; üstüne günde en fazla bir elle format.</p>\n    <div class=\"tablewrap\">\n      <table class=\"plan\">\n        <thead><tr><th>Slot (İstanbul / Hindistan)</th><th>Rol</th><th>Örnek</th></tr></thead>\n        <tbody>\n          <tr><td>10:15 / 12:45</td><td>Günün pratik ayeti: insanlara ve güne dair, \"birine gönder\" türü</td><td>Haber doğrulama (49:6), anne baba (17:23), söz ve dil</td></tr>\n          <tr><td>18:30 / 21:00</td><td>Peygamber duaları ve kıssaları, akşam sakinliği</td><td>Eyyub, Yunus, Musa, Zekeriya duaları</td></tr>\n          <tr><td>21:00 / 23:30</td><td>Kısa, tanınan sureler ve en güçlü pasajlar</td><td>Nâs, İhlâs, Felak gibi; Ayetü'l-Kürsî, Bakara'nın son iki ayeti</td></tr>\n          <tr><td>04:30 / 07:00</td><td>Sabah için kısa umut ve zikir ayeti</td><td>2:152 gibi (en yüksek paylaşım oranı)</td></tr>\n          <tr><td>Elle, ~17:00 / 19:30</td><td>Guess the Surah, haftada 3 (Pzt, Çar, Cum)</td><td>Bölüm numaralı seri, her bölümde bir zor soru</td></tr>\n          <tr><td>Elle, ~08:30 / 11:00</td><td>Zikir/tesbih serisi, haftada 1–2</td><td>Namaz sonrası tesbih (33-33-34), 99 isim</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"fikirler\">\n    <h2>Yeni içerik fikirleri</h2>\n    <ol>\n      <li><b>\"Who made this dua?\"</b> Bir peygamber duası okunur, izleyici hangi peygambere ait olduğunu tahmin eder; cevaptan sonra ayet ve meal. En iyi formatı (tahmin) en çok kaydedilen konuyla (peygamber duaları) birleştirir. Trivia'nın yerine geçebilir.</li>\n      <li><b>Guess the Surah'ı seri yapmak:</b> \"Episode 7\" gibi numara ve her bölümde bir zor soru. Yorumları en çok bu format alıyor; seri, takip etmek için bir neden verir.</li>\n      <li><b>Namaz sonrası tesbih sayacı:</b> 33 Subhanallah, 33 Elhamdülillah, 34 Allahu Ekber (Müslim'de sahih hadis). Tesbih videosu kayıtta en yüksek orana çıktı; bu, her gün dönülecek bir video olur.</li>\n      <li><b>\"Before you…\" ahlak serisi:</b> 49:6 türü, bir davranışa bağlanan ayetler (gıybet, alay, söz tutmak, dürüstlük). En çok paylaşılan ayet Reels'leri bu tür.</li>\n      <li><b>Gece okunanlar:</b> Ayetü'l-Kürsî ve Bakara'nın son iki ayeti, yatmadan önce okunması sahih hadislerle bilinen ayetler. Hiç paylaşılmadılar ve kısa-tanınan sure etkisine benzer bir tanınma taşıyorlar.</li>\n      <li><b>Caption'a bir satır Urduca:</b> Takipçilerin ve etkileşenlerin en büyük grubu Hindistan ve Pakistan. Bizim yazdığımız çağrı cümlesi için, metinler için değil.</li>\n    </ol>\n  </section>\n\n  <section id=\"durdur\">\n    <h2>Bırakılacak ya da düzeltilecekler</h2>\n    <ul>\n      <li><b>Trivia:</b> İki denemede de ayet Reels'inin altında erişim ve çok düşük paylaşım. \"Who made this dua?\" ile değiştirilsin ya da sorular zorlaştırılsın.</li>\n      <li><b>Tesbih girişi:</b> İlk 3 saniyede geçme oranı en yüksek. Besmele yazılırken izleyici neyin geleceğini görmüyor; halka ve ilk isim ilk saniyede görünsün.</li>\n      <li><b>Soru kancaları:</b> Ayet Reels'inde soru kancaları en düşük medyan erişimi ve en yüksek atlanmayı aldı. Ana metnin dokunduğu anı söyleyen kancalar (\"Before you share that news, read this verse\") daha iyi.</li>\n      <li><b>Kâri ağırlıkları:</b> Alafasy ve Sudais öne çıkıyor; Abdul Basit ve Maher'de atlanma yüksek. Ağırlık değişikliği önerisi analistin pazartesi kararına bırakıldı.</li>\n    </ul>\n  </section>\n\n  <section id=\"deneme\">\n    <h2>Önümüzdeki iki hafta için denemeler</h2>\n    <ul>\n      <li><b>Saat:</b> Guess the Surah'ı bir hafta 17:00 İstanbul (Hindistan akşamı), bir hafta 10:00 İstanbul'da paylaşıp 24. saat erişimini karşılaştırmak. Sistem slotlarına dokunmadan saatin etkisini ölçer.</li>\n      <li><b>Kanca:</b> İki hafta boyunca soru kancası yerine \"an\" kancası; analist pazartesi karşılaştırır.</li>\n      <li><b>reel-us:</b> Hadis yerine ayet olduğu için 16 Kasım'da diğer slotlarla aynı tabloda karşılaştırılacak.</li>\n    </ul>\n  </section>\n\n  <details id=\"yontem\">\n    <summary>Yöntem ve sınırlar</summary>\n    <p class=\"muted\">Her Reels'in değerleri gece toplamanın günde iki kez kaydettiği anlık görüntülerden 24. saate doğrusal olarak çekildi. Elle paylaşılanların yalnızca son ölçümü var; her biri, kendisinden en fazla 3,5 gün önce ya da sonra paylaşılan ayet Reels'lerinin aynı yaştaki değerleriyle karşılaştırıldı. Instagram Reels başına takip sayısını vermiyor; takip etkisi günlük takip ile günlük erişim arasındaki ilişkiden tahmin edildi. Gruplar küçük (çoğu 3–13 Reels), konu, kâri ve saat birbirine karışıyor. Arşive alınan 49:12 Reels'i ve istatistiği olmayan iki eski gönderi dışarıda.</p>\n  </details>\n</div>\n\n<script>\n// ---------- calculations (readers see these) ----------\ndash.calc('growth', {\n  title: 'Büyüme özeti', description: 'Son 7 kesin günde takip ve 27 Ekim – 8 Kasım takipçi-dışı erişim payı.',\n  inputs: ['daily'],\n  fn: (daily) => {\n    const rows = daily.map((d) => ({ ...d, follows: +d.follows, unfollows: +d.unfollows, nf: +d.reach_non_followers, f: +d.reach_followers }));\n    const last7 = rows.filter((d) => d.date >= '2026-11-02' && d.date <= '2026-11-08');\n    const span = rows.filter((d) => d.date >= '2026-10-27' && d.date <= '2026-11-08');\n    const sum = (a, k) => a.reduce((s, d) => s + (d[k] || 0), 0);\n    return [{\n      follows_7d: sum(last7, 'follows'), unfollows_7d: sum(last7, 'unfollows'),\n      non_follower_pct: Math.round(1000 * sum(span, 'nf') / (sum(span, 'nf') + sum(span, 'f'))) / 10,\n      follows_per_1000: Math.round(10 * 1000 * sum(span, 'follows') / sum(span, 'nf')) / 10,\n    }];\n  },\n});\n\ndash.calc('formats', {\n  title: 'Formatlar', description: \"Elle paylaşılan formatlar, aynı yaştaki ayet Reels'iyle karşılaştırma (ortalamalar).\",\n  inputs: ['manual'],\n  fn: (manual) => {\n    const by = {};\n    for (const r of manual) (by[r.format] = by[r.format] || []).push(r);\n    const avg = (a, k) => Math.round(10 * a.reduce((s, r) => s + (+r[k]), 0) / a.length) / 10;\n    const avg2 = (a, k) => Math.round(100 * a.reduce((s, r) => s + (+r[k]), 0) / a.length) / 100;\n    return Object.entries(by).map(([format, a]) => ({\n      format, n: a.length, reach_ratio: avg2(a, 'reach_ratio'), watch_s: avg(a, 'watch_s'), verse_watch_s: avg(a, 'verse_watch_s'),\n      skip_pct: avg(a, 'skip_pct'), verse_skip_pct: avg(a, 'verse_skip_pct'), save_pct: avg2(a, 'save_pct'), verse_save_pct: avg2(a, 'verse_save_pct'),\n      share_pct: avg2(a, 'share_pct'), verse_share_pct: avg2(a, 'verse_share_pct'), comments: avg(a, 'comments'),\n    })).sort((x, y) => y.reach_ratio - x.reach_ratio);\n  },\n});\n\nfunction hiGroup(name, title, description, filter, key, order) {\n  dash.calc(name, {\n    title, description, inputs: ['reels'],\n    fn: (reels) => {\n      const keep = reels.filter(filter);\n      const by = {};\n      for (const r of keep) { const k = key(r); if (k == null) continue; (by[k] = by[k] || []).push(r); }\n      const med = (a) => { const s = a.map((r) => +r.reach).sort((x, y) => x - y); const m = s.length >> 1; return s.length % 2 ? s[m] : Math.round((s[m - 1] + s[m]) / 2); };\n      const pct = (a, k) => Math.round(100 * 100 * a.reduce((s, r) => s + (+r[k]), 0) / a.reduce((s, r) => s + (+r.reach), 0)) / 100;\n      const mean = (a, k) => { const v = a.map((r) => r[k]).filter((x) => x != null).map(Number); return v.length ? Math.round(10 * v.reduce((s, x) => s + x, 0) / v.length) / 10 : null; };\n      const rows = Object.entries(by).map(([g, a]) => ({ group: g, n: a.length, median_reach: med(a), save_pct: pct(a, 'saved'), share_pct: pct(a, 'shares'), watch_s: mean(a, 'watch_s'), skip_pct: mean(a, 'skip_pct'), slot_label: a[0].slot_label, content: a[0].content }));\n      return order ? rows.sort(order) : rows.sort((x, y) => y.median_reach - x.median_reach);\n    },\n  });\n}\nhiGroup('slots', 'Slotlar', \"27 Ekim'den beri her slot ve tür.\", (r) => r.posted_at >= '2026-10-27' && r.slot !== 'manual' && r.slot !== 'reel', (r) => r.slot + ' / ' + r.content);\ndash.calc('categories', {\n  title: 'Konular', description: \"Ayet Reels'inin konusu (ve karşılaştırma için sessiz hadis).\",\n  inputs: ['reels'],\n  fn: (reels) => {\n    const by = {};\n    for (const r of reels) (by[r.category] = by[r.category] || []).push(r);\n    const med = (a) => { const s = a.map((r) => +r.reach).sort((x, y) => x - y); const m = s.length >> 1; return s.length % 2 ? s[m] : Math.round((s[m - 1] + s[m]) / 2); };\n    const pct = (a, k) => Math.round(100 * 100 * a.reduce((s, r) => s + (+r[k]), 0) / a.reduce((s, r) => s + (+r.reach), 0)) / 100;\n    const mean = (a, k) => { const v = a.map((r) => r[k]).filter((x) => x != null).map(Number); return v.length ? Math.round(10 * v.reduce((s, x) => s + x, 0) / v.length) / 10 : null; };\n    return Object.entries(by).filter(([, a]) => a.length >= 2).map(([category, a]) => ({ category, n: a.length, median_reach: med(a), save_pct: pct(a, 'saved'), share_pct: pct(a, 'shares'), watch_s: mean(a, 'watch_s') }))\n      .sort((x, y) => y.median_reach - x.median_reach);\n  },\n});\nhiGroup('hooks', 'Kanca türü', \"Ayet Reels'inde kancanın türü.\", (r) => r.content === 'Ayet', (r) => r.hook_type);\nhiGroup('durations', 'Video süresi', \"Ayet Reels'inde video süresi.\", (r) => r.content === 'Ayet' && r.seconds, (r) => (r.seconds < 18 ? '18 sn altı' : r.seconds < 25 ? '18–25 sn' : r.seconds < 32 ? '25–32 sn' : '32 sn ve üstü'),\n  (x, y) => ['18 sn altı', '18–25 sn', '25–32 sn', '32 sn ve üstü'].indexOf(x.group) - ['18 sn altı', '18–25 sn', '25–32 sn', '32 sn ve üstü'].indexOf(y.group));\nhiGroup('reciters', 'Kâriler', \"En az 5 ayet Reels'i olan kâriler.\", (r) => r.content === 'Ayet' && r.reciter, (r) => r.reciter);\n\n// ---------- helpers ----------\nconst hiFmt = { int: d3.format(',d'), one: (v) => (v == null ? '—' : d3.format('.1f')(v)), two: (v) => (v == null ? '—' : d3.format('.2f')(v)) };\nfunction hiDash(el) { el.replaceChildren(); el.textContent = '—'; }\nfunction hiTip(box) {\n  const t = document.createElement('div'); t.className = 'tip'; t.hidden = true; box.appendChild(t);\n  return {\n    show(ev, text) { t.textContent = text; t.hidden = false; const b = box.getBoundingClientRect(); let x = ev.clientX - b.left + 10; const y = ev.clientY - b.top - 28; x = Math.min(x, b.width - t.offsetWidth - 4); t.style.left = Math.max(0, x) + 'px'; t.style.top = y + 'px'; },\n    hide() { t.hidden = true; },\n  };\n}\n// Horizontal bars: rows, label key, value key, source id, field.\nfunction hiBars(el, rows, lab, valKey, src, keyField, fmt, tipText) {\n  el.replaceChildren();\n  const W = el.clientWidth || 320, bh = 22, gap = 8, H = rows.length * (bh + gap);\n  const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', el.getAttribute('aria-label') || 'Çubuk grafik');\n  const labels = svg.append('g');\n  let lw = 0;\n  rows.forEach((r, i) => { const t = labels.append('text').attr('x', 0).attr('y', i * (bh + gap) + bh / 2 + 4).text(r[lab]); lw = Math.max(lw, t.node().getComputedTextLength()); });\n  lw = Math.min(lw + 10, W * 0.5);\n  labels.selectAll('text').each(function () { const n = this; const full = n.textContent; while (n.getComputedTextLength() > lw - 10 && n.textContent.length > 4) n.textContent = n.textContent.slice(0, -2) + '…'; if (n.textContent !== full) d3.select(n).append('title').text(full); });\n  const max = d3.max(rows, (r) => +r[valKey]) || 1;\n  const x = d3.scaleLinear().domain([0, max]).range([0, W - lw - 56]);\n  const tip = hiTip(el);\n  rows.forEach((r, i) => {\n    const y = i * (bh + gap);\n    svg.append('rect').attr('x', lw).attr('y', y).attr('height', bh).attr('width', Math.max(1, x(+r[valKey]))).attr('rx', 3)\n      .style('fill', i === 0 ? dash.colors[0] : 'var(--cds-chart-muted)')\n      .on('pointermove', (ev) => tip.show(ev, tipText(r))).on('pointerleave', () => tip.hide());\n    svg.append('text').attr('class', 'val').attr('x', lw + x(+r[valKey]) + 6).attr('y', y + bh / 2 + 4)\n      .attr('data-source', src).attr('data-field', valKey).attr('data-where', `${keyField}=${encodeURIComponent(r[keyField])}`).text(fmt(+r[valKey]));\n  });\n}\nfunction hiRows(tbody, rows, cols) {\n  tbody.replaceChildren();\n  for (const r of rows) {\n    const tr = document.createElement('tr');\n    for (const [k, f, cls] of cols) { const td = document.createElement('td'); if (cls) td.className = cls; td.textContent = f ? f(r[k], r) : (r[k] ?? '—'); tr.appendChild(td); }\n    tbody.appendChild(tr);\n  }\n}\nfunction hiStatus(el, id) {\n  const d = dash.data(id);\n  if (d.status === 'ok') { el.classList.remove('dash-skeleton'); return d; }\n  if (d.status === 'loading') { el.classList.add('dash-skeleton'); return null; }\n  el.classList.remove('dash-skeleton'); el.replaceChildren(); el.textContent = d.status === 'connect' ? '' : 'Yüklenemedi';\n  return null;\n}\n\n// ---------- drawings ----------\ndash.draw('followers', (el) => { const d = dash.data('account'); el.textContent = d.status === 'ok' && d.data[0] ? hiFmt.int(+d.data[0].followers) : '—'; });\ndash.draw('follows7', (el) => { const d = dash.data('growth'); el.textContent = d.status === 'ok' && d.data[0] ? '+' + hiFmt.int(d.data[0].follows_7d) : '—'; });\ndash.draw('unf7', (el) => { const d = dash.data('growth'); el.textContent = d.status === 'ok' && d.data[0] ? hiFmt.int(d.data[0].unfollows_7d) : '—'; });\ndash.draw('nfShare', (el) => { const d = dash.data('growth'); el.textContent = d.status === 'ok' && d.data[0] ? '%' + hiFmt.one(d.data[0].non_follower_pct) : '—'; });\ndash.draw('per1k', (el) => { const d = dash.data('growth'); el.textContent = d.status === 'ok' && d.data[0] ? hiFmt.one(d.data[0].follows_per_1000) : '—'; });\ndash.draw('gtsRatio', (el) => { const d = dash.data('formats'); const r = d.status === 'ok' ? d.data.find((x) => x.format === 'Guess the Surah') : null; el.textContent = r ? hiFmt.one(r.reach_ratio) : '—'; });\ndash.draw('topCat', (el) => { const d = dash.data('categories'); const r = d.status === 'ok' ? d.data[0] : null; el.textContent = r ? r.category : '—'; });\n\nfunction hiDaily(el, key, color, fmtv) {\n  const d = hiStatus(el, 'daily'); if (!d) return;\n  el.replaceChildren();\n  const rows = d.data.filter((r) => r[key] != null);\n  const W = el.clientWidth || 320, H = 170, m = { t: 18, r: 6, b: 24, l: 6 };\n  const x = d3.scaleBand().domain(rows.map((r) => r.date)).range([m.l, W - m.r]).padding(0.25);\n  const y = d3.scaleLinear().domain([0, d3.max(rows, (r) => +r[key]) || 1]).nice().range([H - m.b, m.t]);\n  const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', key === 'follows' ? 'Günlük yeni takip' : 'Günlük takipçi olmayanlara erişim');\n  const tip = hiTip(el);\n  const lab = (s) => d3.utcFormat('%-d.%m')(new Date(s + 'T00:00:00Z'));\n  svg.selectAll('rect').data(rows).join('rect').attr('x', (r) => x(r.date)).attr('width', x.bandwidth()).attr('y', (r) => y(+r[key])).attr('height', (r) => y(0) - y(+r[key])).attr('rx', 2)\n    .style('fill', color).style('opacity', (r) => (r.provisional ? 0.45 : 1))\n    .on('pointermove', (ev, r) => tip.show(ev, `${lab(r.date)}: ${fmtv(+r[key])}${r.provisional ? ' (geçici)' : ''}`)).on('pointerleave', () => tip.hide());\n  const maxR = rows.reduce((a, r) => (+r[key] > +a[key] ? r : a), rows[0]);\n  svg.append('text').attr('class', 'val').attr('x', x(maxR.date) + x.bandwidth() / 2).attr('y', y(+maxR[key]) - 4).attr('text-anchor', 'middle')\n    .attr('data-source', 'daily').attr('data-field', key).attr('data-where', `date=${maxR.date}`).text(fmtv(+maxR[key]));\n  const step = Math.ceil(rows.length / Math.max(2, Math.floor(W / 46)));\n  rows.forEach((r, i) => { if (i % step === 0 || i === rows.length - 1) svg.append('text').attr('x', x(r.date) + x.bandwidth() / 2).attr('y', H - 6).attr('text-anchor', 'middle').text(lab(r.date)); });\n}\ndash.draw('follows', (el) => hiDaily(el, 'follows', dash.colors[0], hiFmt.int));\ndash.draw('reachDaily', (el) => hiDaily(el, 'reach_non_followers', dash.colors[1], (v) => d3.format('.3~s')(v).replace('k', ' bin')));\n\ndash.draw('formatsBody', (tb) => {\n  const d = dash.data('formats'); if (d.status !== 'ok') { tb.replaceChildren(); return; }\n  const cls = (v, base, higher) => (v == null ? '' : (higher ? v > base : v < base) ? 'num good' : 'num bad');\n  tb.replaceChildren();\n  for (const r of d.data) {\n    const tr = document.createElement('tr');\n    const cells = [\n      [r.format, ''], [r.n, 'num'], [hiFmt.two(r.reach_ratio) + '×', cls(r.reach_ratio, 1, true)],\n      [hiFmt.one(r.watch_s), cls(r.watch_s, r.verse_watch_s, true)], [hiFmt.one(r.verse_watch_s), 'num'],\n      [hiFmt.one(r.skip_pct), cls(r.skip_pct, r.verse_skip_pct, false)], [hiFmt.one(r.verse_skip_pct), 'num'],\n      [hiFmt.two(r.save_pct), cls(r.save_pct, r.verse_save_pct, true)], [hiFmt.two(r.verse_save_pct), 'num'],\n      [hiFmt.two(r.share_pct), cls(r.share_pct, r.verse_share_pct, true)], [hiFmt.two(r.verse_share_pct), 'num'], [hiFmt.one(r.comments), 'num'],\n    ];\n    for (const [v, c] of cells) { const td = document.createElement('td'); td.className = c; td.textContent = v; tr.appendChild(td); }\n    tb.appendChild(tr);\n  }\n});\n\ndash.draw('cats', (el) => {\n  const d = hiStatus(el, 'categories'); if (!d) return;\n  el.setAttribute('aria-label', 'Konuya göre medyan erişim');\n  hiBars(el, d.data, 'category', 'median_reach', 'categories', 'category', hiFmt.int, (r) => `${r.category}: ${hiFmt.int(r.median_reach)} (n=${r.n})`);\n});\ndash.draw('catsBody', (tb) => {\n  const d = dash.data('categories'); if (d.status !== 'ok') { tb.replaceChildren(); return; }\n  hiRows(tb, d.data, [['category'], ['n', null, 'num'], ['save_pct', hiFmt.two, 'num'], ['share_pct', hiFmt.two, 'num'], ['watch_s', hiFmt.one, 'num']]);\n});\ndash.draw('slotsBody', (tb) => {\n  const d = dash.data('slots'); if (d.status !== 'ok') { tb.replaceChildren(); return; }\n  tb.replaceChildren();\n  for (const r of d.data) {\n    const tr = document.createElement('tr'); tr.dataset.key = encodeURIComponent(r.group);\n    const cells = [[r.slot_label], [r.content], [r.n, 'num'], [hiFmt.int(r.median_reach), 'num'], [hiFmt.two(r.save_pct), 'num'], [hiFmt.two(r.share_pct), 'num'], [hiFmt.one(r.watch_s), 'num'], [hiFmt.one(r.skip_pct), 'num']];\n    for (const [v, c] of cells) { const td = document.createElement('td'); if (c) td.className = c; td.textContent = v; tr.appendChild(td); }\n    tb.appendChild(tr);\n  }\n});\n\nconst HI_SLOTS_IST = [4.5, 10.25, 18.5, 21];   // our slot times, Istanbul hours (fixed reference)\ndash.draw('online', (el) => {\n  const d = hiStatus(el, 'online'); if (!d) return;\n  el.replaceChildren();\n  const rows = d.data.map((r) => ({ ...r, h: +r.istanbul_hour, v: +r.online_followers })).sort((a, b) => a.h - b.h);\n  const W = el.clientWidth || 320, H = 170, m = { t: 18, r: 6, b: 24, l: 6 };\n  const x = d3.scaleLinear().domain([0, 24]).range([m.l, W - m.r]);\n  const y = d3.scaleLinear().domain([0, d3.max(rows, (r) => r.v)]).nice().range([H - m.b, m.t]);\n  const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', 'Saate göre çevrimiçi takipçi, İstanbul saati');\n  const tip = hiTip(el);\n  const bw = (x(1) - x(0)) * 0.75;\n  svg.selectAll('rect').data(rows).join('rect').attr('x', (r) => x(r.h) + ((x(1) - x(0)) - bw) / 2).attr('width', bw).attr('y', (r) => y(r.v)).attr('height', (r) => y(0) - y(r.v)).attr('rx', 2)\n    .style('fill', 'var(--cds-chart-muted)')\n    .on('pointermove', (ev, r) => tip.show(ev, `${String(r.h).padStart(2, '0')}:00 İstanbul (Hindistan ${r.india_time}): ${r.v}`)).on('pointerleave', () => tip.hide());\n  for (const s of HI_SLOTS_IST) svg.append('line').attr('x1', x(s)).attr('x2', x(s)).attr('y1', m.t - 6).attr('y2', H - m.b).style('stroke', dash.colors[0]).style('stroke-width', 2);\n  const peak = rows.reduce((a, r) => (r.v > a.v ? r : a), rows[0]);\n  svg.append('text').attr('class', 'val').attr('x', x(peak.h + 0.5)).attr('y', y(peak.v) - 4).attr('text-anchor', 'middle')\n    .attr('data-source', 'online').attr('data-field', 'online_followers').attr('data-where', `utc_hour=${peak.utc_hour}`).text(peak.v);\n  for (const h of [0, 6, 12, 18]) svg.append('text').attr('x', x(h + 0.5)).attr('y', H - 6).attr('text-anchor', 'middle').text(String(h).padStart(2, '0') + ':00');\n});\ndash.draw('aud', (el) => {\n  const d = hiStatus(el, 'audience'); if (!d) return;\n  el.replaceChildren();\n  const names = { IN: 'Hindistan', PK: 'Pakistan', SA: 'S. Arabistan', GB: 'İngiltere', US: 'ABD', AE: 'BAE', MY: 'Malezya', NG: 'Nijerya', CA: 'Kanada', TR: 'Türkiye', DE: 'Almanya' };\n  const groups = ['Takipçi', 'Etkileşen'];\n  for (const g of groups) {\n    const box = document.createElement('div'); box.className = 'chart'; box.style.minHeight = '0';\n    const cap = document.createElement('div'); cap.className = 'muted'; cap.textContent = g; el.appendChild(cap); el.appendChild(box);\n    const rows = d.data.filter((r) => r.group === g).map((r) => ({ ...r, name: names[r.country] || r.country, key: `group=${encodeURIComponent(g)}&country=${r.country}` }));\n    box.setAttribute('aria-label', `${g} ülke dağılımı`);\n    const W = box.clientWidth || 300, bh = 18, gap = 6, H = rows.length * (bh + gap);\n    const svg = d3.select(box).append('svg').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', `${g} ülke dağılımı`);\n    const lw = 92, x = d3.scaleLinear().domain([0, 50]).range([0, W - lw - 46]);\n    rows.forEach((r, i) => {\n      const yy = i * (bh + gap);\n      svg.append('text').attr('x', 0).attr('y', yy + bh / 2 + 4).text(r.name);\n      svg.append('rect').attr('x', lw).attr('y', yy).attr('height', bh).attr('width', Math.max(1, x(+r.share_pct))).attr('rx', 3).style('fill', r.country === 'IN' || r.country === 'PK' ? dash.colors[0] : 'var(--cds-chart-muted)');\n      svg.append('text').attr('class', 'val').attr('x', lw + x(+r.share_pct) + 6).attr('y', yy + bh / 2 + 4).attr('data-source', 'audience').attr('data-field', 'share_pct').attr('data-where', r.key).text('%' + hiFmt.one(+r.share_pct));\n    });\n  }\n});\nfunction hiSmall(name, src, ariaLabel, minN) {\n  dash.draw(name, (el) => {\n    const d = hiStatus(el, src); if (!d) return;\n    el.setAttribute('aria-label', ariaLabel);\n    const rows = d.data.filter((r) => r.n >= (minN || 1));\n    hiBars(el, rows, 'group', 'median_reach', src, 'group', hiFmt.int, (r) => `${r.group}: ${hiFmt.int(r.median_reach)} · n=${r.n} · atlanma %${hiFmt.one(r.skip_pct)}`);\n  });\n}\nhiSmall('hooks', 'hooks', 'Kanca türüne göre medyan erişim');\nhiSmall('durs', 'durations', 'Video süresine göre medyan erişim');\nhiSmall('recs', 'reciters', 'Kâriye göre medyan erişim', 5);\n\ndash.draw('topBody', (tb) => {\n  const d = dash.data('reels'); if (d.status !== 'ok') { tb.replaceChildren(); return; }\n  const s = [...d.data].sort((a, b) => b.reach - a.reach);\n  const pick = [...s.slice(0, 8), ...s.slice(-5)];\n  tb.replaceChildren();\n  pick.forEach((r, i) => {\n    if (i === 8) { const sep = document.createElement('tr'); const td = document.createElement('td'); td.colSpan = 7; td.className = 'muted'; td.textContent = 'En az erişen 5'; sep.appendChild(td); tb.appendChild(sep); }\n    const tr = document.createElement('tr'); tr.dataset.key = encodeURIComponent(r.ref);\n    const cells = [[r.ref], [r.hook], [r.category], [r.slot], [hiFmt.int(r.reach), 'num'], [r.saved, 'num'], [r.shares, 'num']];\n    for (const [v, c] of cells) { const td = document.createElement('td'); if (c) td.className = c; td.textContent = v; tr.appendChild(td); }\n    tb.appendChild(tr);\n  });\n});\n</script>\n", "edit": {"via": "claude", "at": "2026-11-10T04:46:31Z"}}